# Environment variables for FutManager
# Copie este arquivo para .env e preencha as variáveis conforme seu ambiente

# --- Banco de Dados PostgreSQL (Local ou Supabase) ---
# Para execução local via Docker:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=futmanager
DB_USER=futmanager
DB_PASSWORD=futmanager
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/futmanager?sslmode=disable
SPRING_DATASOURCE_USERNAME=futmanager
SPRING_DATASOURCE_PASSWORD=futmanager

# Para Supabase (substitua com suas credenciais do painel Supabase):
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=YOUR_PASSWORD

# --- Supabase Auth & JWT ---
# URL da sua instância Supabase (ex: https://xyzcompany.supabase.co)
SUPABASE_URL=http://localhost:8000
# Chave anônima pública (usada pelo Frontend)
SUPABASE_ANON_KEY=dev-anon-key
# Chave JWT Secret do Supabase (para validação HMAC no backend) ou use JWKS
SUPABASE_JWT_SECRET=super-secret-jwt-key-for-futmanager-development-must-be-at-least-256-bits-long
# Modo de autenticação: 'supabase' ou 'dev' (em 'dev', permite login com credenciais de demonstração)
AUTH_MODE=dev

# --- Supabase Storage (Fotos) ---
SUPABASE_STORAGE_BUCKET=student-photos
# Pasta local de fallback para fotos quando não usar Supabase Storage diretamente
STORAGE_LOCAL_DIR=./uploads

# --- Servidor Backend ---
PORT=8080
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# --- E-mail Transacional (Resend) & Segurança ---
# API Key do Resend (ex: re_123456789...)
RESEND_API_KEY=
# Endereço remetente com domínio verificado no Resend
RESEND_FROM_EMAIL="FutManager <nao-responda@seudominio.com.br>"
# URL pública do frontend para links de verificação e redefinição de senha
APP_FRONTEND_URL=http://localhost:5173
# Tempo de expiração dos tokens
PASSWORD_RESET_VALIDITY_MINUTES=15
EMAIL_VERIFICATION_VALIDITY_HOURS=24

# --- Frontend ---
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=dev-anon-key
VITE_AUTH_MODE=dev
