# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Source code and configuration files
*.java text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.xml text eol=lf
*.properties text eol=lf
Dockerfile* text eol=lf
nginx*.conf text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.jar binary
*.xlsx binary
*.pdf binary
